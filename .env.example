# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# AI Features (Optional - if not provided, fallback logic will be used)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"
# Alternative: GOOGLE_API_KEY="your-google-api-key-here"
# Shared limit for all AI features, per client IP. Defaults: 20 requests / 3600 seconds.
AI_RATE_LIMIT_MAX_REQUESTS="20"
AI_RATE_LIMIT_WINDOW_SECONDS="3600"

# Demo Tenant ID (for multi-tenant setup)
NEXT_PUBLIC_DEMO_TENANT_ID="nextjs-demo-tenant-id"

# Email Configuration (Required for tenant invitations)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_123456789_your_resend_api_key_here"
EMAIL_FROM="MiNi Property <noreply@yourdomain.com>"
NEXT_PUBLIC_APP_URL="http://localhost:9002"

# Alternative SMTP Configuration (if not using Resend)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Other environment variables
# Add any other environment variables your app needs here
